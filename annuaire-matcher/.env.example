# French e-invoicing annuaire API configuration
# Copy this file to .env and fill in your credentials

# API base URL (DGFIP annuaire de la facturation électronique)
ANNUAIRE_API_BASE_URL=https://api.annuaire-facturation.dgfip.finances.gouv.fr/v1

# API key or Bearer token (obtain from DGFIP / your PDP)
ANNUAIRE_API_KEY=

# Optional: request timeout in seconds
API_TIMEOUT=15

# Optional: max concurrent API requests (be polite to the API)
MAX_WORKERS=3
